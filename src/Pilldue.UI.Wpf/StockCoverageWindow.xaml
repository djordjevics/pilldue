<Window x:Class="Pilldue.UI.Wpf.StockCoverageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Pilldue.UI.Wpf"
        Title="{wpf:Loc Desktop.Coverage}"
        Height="560"
        Width="840"
        MinHeight="400"
        MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,12"
                   Text="{Binding AsOfText}" />
        <Button DockPanel.Dock="Bottom"
                Content="{wpf:Loc Common.Back}"
                Width="88"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                IsCancel="True" />
        <TabControl>
            <TabItem Header="{wpf:Loc Plan.Coverage}">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{wpf:Loc Plan.EmptyMeds}"
                               Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCoverageEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding CoverageRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{wpf:Loc List.ColName}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{wpf:Loc Plan.ColNext}" Binding="{Binding NextRefill}" Width="110" />
                            <DataGridTextColumn Header="{wpf:Loc Plan.ColLast}" Binding="{Binding LastCovered}" Width="120" />
                            <DataGridTextColumn Header="{wpf:Loc Plan.ColCovers}" Binding="{Binding Covers}" Width="80" />
                            <DataGridTextColumn Header="{wpf:Loc Plan.ColPillsShort}" Binding="{Binding PillsShort}" Width="90" />
                            <DataGridTextColumn Header="{wpf:Loc Plan.ColPackages}" Binding="{Binding PackagesToBuy}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{wpf:Loc Plan.Short}">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{wpf:Loc Plan.ShortEmpty}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShortEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding ShortRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{wpf:Loc List.ColName}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{wpf:Loc Plan.ColNext}" Binding="{Binding NextRefill}" Width="110" />
                            <DataGridTextColumn Header="{wpf:Loc Plan.ColPillsShort}" Binding="{Binding PillsShort}" Width="90" />
                            <DataGridTextColumn Header="{wpf:Loc Plan.ColPackages}" Binding="{Binding PackagesToBuy}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{wpf:Loc Plan.Extra}">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{wpf:Loc Plan.ExtraEmpty}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExtraEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding ExtraRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{wpf:Loc List.ColName}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{wpf:Loc Plan.ColSecond}" Binding="{Binding SecondRefill}" Width="120" />
                            <DataGridTextColumn Header="{wpf:Loc Plan.ColNeeded}" Binding="{Binding PackagesNeeded}" Width="130" />
                            <DataGridTextColumn Header="{wpf:Loc Plan.ColPrescribed}" Binding="{Binding Prescribed}" Width="100" />
                            <DataGridTextColumn Header="{wpf:Loc Plan.ColExtra}" Binding="{Binding ExtraPackages}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
