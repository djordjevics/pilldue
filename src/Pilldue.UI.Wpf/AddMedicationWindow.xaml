<Window x:Class="Pilldue.UI.Wpf.AddMedicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Pilldue.UI.Wpf"
        Title="{wpf:Loc Med.AddTitle}"
        Height="420"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{wpf:Loc List.ColName}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{wpf:Loc Desktop.PackageSize}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox x:Name="PackageSizeBox" Grid.Row="1" Grid.Column="1" Text="28" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{wpf:Loc Desktop.Prescribed}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox x:Name="PrescribedBox" Grid.Row="2" Grid.Column="1" Text="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{wpf:Loc Desktop.PillsPerDose}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox x:Name="DosageBox" Grid.Row="3" Grid.Column="1" Text="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="{wpf:Loc Desktop.ColInterval}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox x:Name="IntervalBox" Grid.Row="4" Grid.Column="1" Text="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="{wpf:Loc Desktop.Stock}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox x:Name="StockBox" Grid.Row="5" Grid.Column="1" Text="0" Margin="0,0,0,8" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="{wpf:Loc Desktop.RxStart}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox x:Name="RxStartBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="7" Grid.Column="0" Text="{wpf:Loc Desktop.RxMonths}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox x:Name="DurationBox" Grid.Row="7" Grid.Column="1" Text="6" Margin="0,0,0,8" />

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{wpf:Loc Common.Cancel}" Width="88" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" />
            <Button Content="{wpf:Loc Desktop.Save}" Width="88" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
