<Window x:Class="Pilldue.UI.Wpf.AddMedicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Pilldue.UI.Wpf"
        Title="{Binding Title}"
        Height="420"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        wpf:DialogCloser.CloseResult="{Binding CloseResult, Mode=OneWay}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{wpf:Loc List.ColName}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{wpf:Loc Desktop.PackageSize}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding PackageSize, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{wpf:Loc Desktop.Prescribed}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Prescribed, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{wpf:Loc Desktop.PillsPerDose}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Dosage, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="{wpf:Loc Desktop.ColInterval}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="{wpf:Loc Desktop.Stock}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="{wpf:Loc Desktop.RxStart}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Text="{Binding RxStart, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="7" Grid.Column="0" Text="{wpf:Loc Desktop.RxMonths}" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{wpf:Loc Common.Cancel}" Width="88" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
            <Button Content="{wpf:Loc Desktop.Save}" Width="88" IsDefault="True" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
