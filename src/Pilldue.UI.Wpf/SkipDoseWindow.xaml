<Window x:Class="Pilldue.UI.Wpf.SkipDoseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Pilldue.UI.Wpf"
        Title="{wpf:Loc Skip.Title}"
        Height="250"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        wpf:DialogCloser.CloseResult="{Binding CloseResult, Mode=OneWay}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"
                   Text="{Binding MedicationName}" />

        <TextBlock Grid.Row="1"
                   Text="{wpf:Loc Skip.Pills}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />
        <TextBox Grid.Row="2" Margin="0,0,0,12" Text="{Binding PillsText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="3"
                   Text="{wpf:Loc Skip.Date}"
                   Margin="0,0,0,8" />
        <TextBox Grid.Row="4" Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{wpf:Loc Common.Cancel}"
                    Width="88"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}" />
            <Button Content="{wpf:Loc Skip.Title}"
                    Width="110"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</Window>
