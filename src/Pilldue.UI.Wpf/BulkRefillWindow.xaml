<Window x:Class="Pilldue.UI.Wpf.BulkRefillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Pilldue.UI.Wpf"
        Title="{wpf:Loc BulkRefill.Title}"
        Height="480"
        Width="520"
        MinHeight="320"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="{wpf:Loc BulkRefill.Hint}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{wpf:Loc Common.Cancel}"
                    Width="88"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button Content="{wpf:Loc BulkRefill.Title}"
                    MinWidth="140"
                    IsDefault="True"
                    Click="OnConfirmClick" />
        </StackPanel>

        <TextBlock x:Name="EmptyText"
                   DockPanel.Dock="Top"
                   Text="{wpf:Loc BulkRefill.Empty}"
                   Visibility="Collapsed"
                   Margin="0,0,0,8" />

        <DataGrid x:Name="MedicationsGrid"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{wpf:Loc List.ColName}"
                                    Binding="{Binding Name}"
                                    IsReadOnly="True"
                                    Width="*" />
                <DataGridTextColumn Header="{wpf:Loc BulkRefill.Packages}"
                                    Binding="{Binding PackageCountText, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
