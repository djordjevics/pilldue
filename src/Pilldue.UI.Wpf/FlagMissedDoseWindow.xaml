<Window x:Class="Pilldue.UI.Wpf.FlagMissedDoseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Pilldue.UI.Wpf"
        Title="{wpf:Loc Missed.Flag}"
        Height="210"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        wpf:DialogCloser.CloseResult="{Binding CloseResult, Mode=OneWay}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Text="{Binding MedicationName}" />

        <TextBlock Grid.Row="1"
                   Text="{wpf:Loc Missed.Date}"
                   Margin="0,0,0,8" />
        <TextBox Grid.Row="2" Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{wpf:Loc Common.Cancel}"
                    Width="88"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}" />
            <Button Content="{wpf:Loc Missed.Flag}"
                    Width="140"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</Window>
