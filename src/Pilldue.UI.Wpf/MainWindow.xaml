<Window x:Class="Pilldue.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Pilldue.UI.Wpf"
        Title="Pilldue"
        Height="520"
        Width="840"
        MinHeight="360"
        MinWidth="720"
        Loaded="OnLoaded">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Pilldue"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <Button x:Name="RefreshButton" Content="{wpf:Loc Desktop.Refresh}" Width="88" Margin="0,0,8,0" Click="OnRefreshClick" />
                <Button x:Name="AddButton" Content="{wpf:Loc Desktop.Add}" Width="72" Margin="0,0,8,0" Click="OnAddClick" />
                <Button x:Name="EditButton" Content="{wpf:Loc Desktop.Edit}" Width="80" Margin="0,0,8,0" Click="OnEditClick" />
                <Button x:Name="RefillButton" Content="{wpf:Loc Desktop.Refill}" Width="72" Margin="0,0,8,0" Click="OnRefillClick" />
                <Button x:Name="RemoveButton" Content="{wpf:Loc Desktop.Remove}" Width="88" Click="OnRemoveClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CoverageButton" Content="{wpf:Loc Desktop.Coverage}" Width="108" Margin="0,0,8,0" Click="OnCoverageClick" />
                <Button x:Name="SkipButton" Content="{wpf:Loc Desktop.Skip}" Width="72" Margin="0,0,8,0" Click="OnSkipClick" />
                <Button x:Name="MissedButton" Content="{wpf:Loc Desktop.Missed}" Width="80" Margin="0,0,8,0" Click="OnMissedClick" />
                <Button x:Name="CalendarButton" Content="{wpf:Loc Desktop.Calendar}" Width="88" Margin="0,0,8,0" Click="OnCalendarClick" />
                <Button x:Name="SettingsButton" Content="{wpf:Loc Desktop.Settings}" MinWidth="88" Click="OnSettingsClick" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   Margin="0,12,0,0"
                   Foreground="Gray"
                   TextWrapping="Wrap" />

        <DataGrid x:Name="MedicationsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{wpf:Loc List.ColName}" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="{wpf:Loc List.ColStock}" Binding="{Binding CurrentStockPills}" Width="80" />
                <DataGridTextColumn Header="{wpf:Loc Desktop.ColDose}" Binding="{Binding DailyDosagePills}" Width="70" />
                <DataGridTextColumn Header="{wpf:Loc Desktop.ColInterval}" Binding="{Binding DoseIntervalDays}" Width="110" />
                <DataGridTextColumn Header="{wpf:Loc List.ColPackage}" Binding="{Binding PackageSizePills}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
