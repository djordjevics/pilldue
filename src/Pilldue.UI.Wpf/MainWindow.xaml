<Window x:Class="Pilldue.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Pilldue.UI.Wpf"
        Title="Pilldue"
        Height="520"
        Width="840"
        MinHeight="360"
        MinWidth="720">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Pilldue"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <Button Content="{Binding RefreshCaption}" Width="88" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
                <Button Content="{Binding AddCaption}" Width="72" Margin="0,0,8,0" Command="{Binding AddCommand}" />
                <Button Content="{Binding EditCaption}" Width="80" Margin="0,0,8,0" Command="{Binding EditCommand}" />
                <Button Content="{Binding RefillCaption}" Width="72" Margin="0,0,8,0" Command="{Binding RefillCommand}" />
                <Button Content="{Binding RemoveCaption}" Width="88" Command="{Binding RemoveCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding CoverageCaption}" Width="108" Margin="0,0,8,0" Command="{Binding CoverageCommand}" />
                <Button Content="{Binding SkipCaption}" Width="72" Margin="0,0,8,0" Command="{Binding SkipCommand}" />
                <Button Content="{Binding MissedCaption}" Width="80" Margin="0,0,8,0" Command="{Binding MissedCommand}" />
                <Button Content="{Binding CalendarCaption}" Width="88" Margin="0,0,8,0" Command="{Binding CalendarCommand}" />
                <Button Content="{Binding SettingsCaption}" MinWidth="88" Command="{Binding SettingsCommand}" />
            </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Margin="0,12,0,0"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Text="{Binding StatusText}" />

        <DataGrid ItemsSource="{Binding Medications}"
                  SelectedItem="{Binding SelectedMedication}"
                  wpf:MedicationColumnHeaders.Name="{Binding NameHeader}"
                  wpf:MedicationColumnHeaders.Stock="{Binding StockHeader}"
                  wpf:MedicationColumnHeaders.Dose="{Binding DoseHeader}"
                  wpf:MedicationColumnHeaders.Interval="{Binding IntervalHeader}"
                  wpf:MedicationColumnHeaders.Package="{Binding PackageHeader}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Binding="{Binding CurrentStockPills}" Width="80" />
                <DataGridTextColumn Binding="{Binding DailyDosagePills}" Width="70" />
                <DataGridTextColumn Binding="{Binding DoseIntervalDays}" Width="110" />
                <DataGridTextColumn Binding="{Binding PackageSizePills}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
