<Window x:Class="Pilldue.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Pilldue.UI.Wpf"
        Title="Pilldue"
        Height="520"
        Width="960"
        MinHeight="360"
        MinWidth="800"
        Loaded="OnLoaded">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Pilldue"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />
            <Button Content="{wpf:Loc Desktop.Refresh}" Width="88" Margin="0,0,8,0" Click="OnRefreshClick" />
            <Button Content="{wpf:Loc Desktop.Add}" Width="72" Margin="0,0,8,0" Click="OnAddClick" />
            <Button Content="{wpf:Loc Desktop.Edit}" Width="80" Margin="0,0,8,0" Click="OnEditClick" />
            <Button Content="{wpf:Loc Desktop.Refill}" Width="72" Margin="0,0,8,0" Click="OnRefillClick" />
            <Button Content="{wpf:Loc Desktop.Remove}" Width="88" Margin="0,0,8,0" Click="OnRemoveClick" />
            <Button Content="{wpf:Loc Desktop.Coverage}" Width="108" Margin="0,0,8,0" Click="OnCoverageClick" />
            <Button Content="{wpf:Loc Desktop.Calendar}" Width="88" Click="OnCalendarClick" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   Margin="0,12,0,0"
                   Foreground="Gray"
                   TextWrapping="Wrap" />

        <DataGrid x:Name="MedicationsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{wpf:Loc List.ColName}" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="{wpf:Loc List.ColStock}" Binding="{Binding CurrentStockPills}" Width="80" />
                <DataGridTextColumn Header="{wpf:Loc Desktop.ColDose}" Binding="{Binding DailyDosagePills}" Width="70" />
                <DataGridTextColumn Header="{wpf:Loc Desktop.ColInterval}" Binding="{Binding DoseIntervalDays}" Width="110" />
                <DataGridTextColumn Header="{wpf:Loc List.ColPackage}" Binding="{Binding PackageSizePills}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
