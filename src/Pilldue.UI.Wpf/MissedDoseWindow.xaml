<Window x:Class="Pilldue.UI.Wpf.MissedDoseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Pilldue.UI.Wpf"
        Title="{wpf:Loc Missed.Title}"
        Height="460"
        Width="560"
        MinHeight="320"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="{wpf:Loc Missed.Hint}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{wpf:Loc Missed.Flag}"
                    Width="140"
                    Margin="0,0,8,0"
                    Click="OnFlagClick" />
            <Button Content="{wpf:Loc Common.Back}"
                    Width="88"
                    IsCancel="True" />
        </StackPanel>
        <DockPanel>
            <TextBlock x:Name="EmptyText"
                       DockPanel.Dock="Top"
                       Text="{wpf:Loc Missed.ListEmpty}"
                       Visibility="Collapsed"
                       Margin="0,0,0,8" />
            <DataGrid x:Name="MissedGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{wpf:Loc Missed.ColDate}" Binding="{Binding Date}" Width="120" />
                    <DataGridTextColumn Header="{wpf:Loc Missed.ColMed}" Binding="{Binding Medication}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
