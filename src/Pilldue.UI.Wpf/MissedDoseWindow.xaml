<Window x:Class="Pilldue.UI.Wpf.MissedDoseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Pilldue.UI.Wpf"
        Title="{wpf:Loc Missed.Title}"
        Height="460"
        Width="560"
        MinHeight="320"
        MinWidth="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="{wpf:Loc Missed.Hint}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{wpf:Loc Missed.Flag}"
                    Width="140"
                    Margin="0,0,8,0"
                    Command="{Binding FlagCommand}" />
            <Button Content="{wpf:Loc Common.Back}"
                    Width="88"
                    IsCancel="True" />
        </StackPanel>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="{wpf:Loc Missed.ListEmpty}"
                       Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{wpf:Loc Missed.ColDate}" Binding="{Binding Date}" Width="120" />
                    <DataGridTextColumn Header="{wpf:Loc Missed.ColMed}" Binding="{Binding Medication}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
